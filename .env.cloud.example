# Template only. Do not activate against any cloud project during local regression.
SPRING_PROFILES_ACTIVE=cloud
DB_URL=jdbc:postgresql://REPLACE_FROM_SUPABASE_CONNECT:5432/postgres?sslmode=require
DB_USERNAME=REPLACE_FROM_SUPABASE_CONNECT
DB_PASSWORD=REPLACE_WITH_PRIVATE_DATABASE_PASSWORD
DB_SCHEMA=caizhitong
DB_POOL_MAX=3
DB_POOL_MIN=0
# Flyway always uses a separate connection. These may match runtime credentials.
FLYWAY_DB_URL=jdbc:postgresql://REPLACE_FROM_SUPABASE_CONNECT:5432/postgres?sslmode=require
FLYWAY_DB_USERNAME=REPLACE_FROM_SUPABASE_CONNECT
FLYWAY_DB_PASSWORD=REPLACE_WITH_PRIVATE_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_NEW_BASE64_RANDOM_SECRET
JWT_TTL_SECONDS=7200
DEMO_ENABLED=false
SERVER_PORT=10000
BUSINESS_TIME_ZONE=Asia/Shanghai
# Empty until a real frontend origin is approved; never use production wildcard CORS.
CORS_ALLOWED_ORIGINS=
PUBLIC_WEB_URL=
STORAGE_MODE=supabase
SUPABASE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=caizhitong-attachments
SUPABASE_STORAGE_KEY=REPLACE_WITH_SERVER_SIDE_STORAGE_KEY
# Enable only for the first controlled startup after database/storage validation.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_UNIQUE_INITIAL_USERNAME
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_ONE_TIME_PRIVATE_PASSWORD
MAIL_DISPATCH_ENABLED=false
