# Copy via scripts/setup-local.ps1 to generate local-only random secrets.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/caizhitong
DB_USERNAME=caizhitong
DB_PASSWORD=REPLACE_WITH_RANDOM_VALUE
POSTGRES_PORT=5432
JWT_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
JWT_TTL_SECONDS=7200
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
SERVER_PORT=8080
PUBLIC_WEB_URL=http://127.0.0.1:5173
BUSINESS_TIME_ZONE=Asia/Shanghai
# Development password accounts only; independent demo_* catalogue is seeded separately.
DEMO_ENABLED=true
DEMO_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
DEMO_LAB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
DEMO_STUDENT_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD

# Optional Sprint 05 local photo storage (relative to backend working directory).
STORAGE_ROOT=./.runtime/uploads
ALERT_SCAN_ENABLED=true
# No SMTP credentials are required for local use. Missing config is shown honestly.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_RECIPIENTS=
MAIL_STARTTLS=true
MAIL_SSL=false
MAIL_DISPATCH_ENABLED=true

# GitHub OAuth is opt-in. Set real credentials only in ignored/private backend config.
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
