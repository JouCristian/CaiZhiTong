# Empty = same-origin /api. Production can set an HTTPS backend origin (without /api).
VITE_API_BASE_URL=
# Optional: 12000–300000 ms. Render Free production uses 240000 for cold starts.
VITE_API_TIMEOUT_MS=12000
# Development proxy only; excluded from production application code.
API_PROXY_TARGET=http://127.0.0.1:8080

